# Copy to .env.local (gitignored — never commit real values) and fill in.
# Without these, video upload falls back to the existing mock flow —
# see docs/decisions.md "Pitch video: length cap, storage, and delivery".

# Mux Dashboard -> Settings -> API Access Tokens -> generate with
# Mux Video read + write.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mux Dashboard -> Settings -> Webhooks -> add an endpoint pointing at
# <your-deployed-url>/api/mux/webhook. The signing secret is shown when
# you create the endpoint. Localhost isn't reachable by Mux directly —
# use a tunnel (ngrok, cloudflared) for local testing.
MUX_WEBHOOK_SECRET=
